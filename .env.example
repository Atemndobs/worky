## Public client variables (bundled into the app)
# These are intended for the client and are NOT secrets.
# Replace with your Supabase project URL and anon key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

## Private server-only variables (never bundle in the client)
# Do not expose these; keep only in local .env or server config.
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-db-password

