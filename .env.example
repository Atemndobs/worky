# Worky App Environment Variables
# Copy this file to .env and fill in your actual values

# Supabase Configuration
# Get these from your Supabase project dashboard
EXPO_PUBLIC_SUPABASE_URL=your-supabase-project-url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Testing Configuration (Optional)
# Only needed for integration tests
TEST_USER_PASSWORD=your-test-user-password
RUN_INTEGRATION_TESTS=false

# Note: These are public environment variables (prefixed with EXPO_PUBLIC_)
# They will be included in your app bundle and visible to clients
# Only use the anon key here, never your service role key or database password

# IMPORTANT SECURITY NOTES:
# - Never commit your actual .env file
# - Never include service role keys or database passwords
# - The anon key is safe to expose as it's protected by RLS policies
# - Use proper Row Level Security (RLS) policies in your database