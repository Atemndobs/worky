+migrate_database() {
+    echo "🚀 Starting Worky database migration..."
+    
+    # Check if psql is installed
+    if ! command -v psql &> /dev/null
+    then
+        echo "❌ psql could not be found. Please install PostgreSQL client tools."
+        exit 1
